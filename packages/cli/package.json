  },
  "dependencies": {
    "@bossflow/core": "workspace:*",
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
